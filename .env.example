# คัดลอกไฟล์นี้เป็น .env.local แล้วกรอกค่าจาก Connect ของโปรเจกต์ Supabase
# ใช้ Publishable key สำหรับเว็บ (sb_publishable_...) โดยสิทธิ์ข้อมูลควบคุมด้วย RLS
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# ต้นทางเว็บสำหรับ OAuth เช่น http://localhost:3000 และเปลี่ยนเป็น HTTPS เมื่อ deploy
NEXT_PUBLIC_SITE_URL=http://localhost:3000
